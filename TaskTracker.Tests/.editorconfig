# Правила для тестового проєкту (сфера дії стандарту, розділ 1.1: тести — з винятками нижче)
[*.cs]
# N-14: тести іменуємо за схемою Метод_Умова_Результат, підкреслення — частина конвенції
dotnet_diagnostic.CA1707.severity = none
dotnet_naming_rule.members_pascal.severity = none
# C-06/C-07: назва тесту сама є його документацією; XML-коментарі для тестів не вимагаємо
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.CS1591.severity = none
# F-09: тестові дублери (фейки, стаби) дозволено тримати разом в одному файлі Doubles.cs
dotnet_diagnostic.SA1402.severity = none
dotnet_diagnostic.SA1649.severity = none
