# Успадкований модуль поза сферою дії стандарту v2.0 (розділ 1.1); аналізатори .NET
# лишаються ввімкненими (карантин TD-05 знято в ЛР8). Винятки:
[*.cs]
# C-07: XML-документацію в модулі, який виводять з експлуатації, не дописуємо (TD-11)
dotnet_diagnostic.CS1591.severity = none
# S-02: перевірку аргументів на null (CA1062, увімкнено в стандарті v2.0) у модулі не додаємо —
# змінювати публічну поведінку успадкованого коду без погодження з викликачами заборонено (TD-11)
dotnet_diagnostic.CA1062.severity = none
