# Правила для тестів успадкованого модуля (поза сферою дії стандарту, розділ 1.1)
[*.cs]
# тести іменуємо за схемою Метод_Умова_Результат, підкреслення — частина конвенції
dotnet_diagnostic.CA1707.severity = none
dotnet_naming_rule.members_pascal.severity = none
# характеризаційні тести документує їхня назва
dotnet_diagnostic.CS1591.severity = none
